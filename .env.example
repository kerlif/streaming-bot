# ---- مطلوب ----
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# معرّفك على تيليجرام (من @userinfobot). بدونه يرفض البوت الجميع. عدة مدراء مفصولون بفاصلة
ADMIN_IDS=123456789

# ---- اختياري ----
DEFAULT_LANGUAGE=ar
LOG_LEVEL=INFO
# داخل Docker يُضبط تلقائياً إلى /app/data/stream_manager.db
DATABASE_PATH=./stream_manager.db
FFMPEG_TIMEOUT=15000000
RECONNECT_DELAY=5
MAX_BACKOFF=60
NOTIFY_AFTER_FAILURES=3
# ملف cookies.txt ليوتيوب إن حجبت خوادم الاستضافة yt-dlp (مثال: /app/data/cookies.txt)
# YTDLP_COOKIES=/app/data/cookies.txt
# أقصى عدد بثوث متزامنة (0 = بلا حد) ومهلة معالج الإعداد بالثواني
MAX_STREAMS=5
SETUP_TIMEOUT=600
